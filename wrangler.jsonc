{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insight-lab-reports",
  "main": "src/worker.js",
  "compatibility_date": "2024-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insight_db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
